# Watch Tower env vars. Copy this file to .env next to compose.yaml, then set the values.
# Git ignores .env. Each secret can also come from a file: WT_<NAME>_FILE=/run/secrets/<name>.

# Docker API URL. compose.yaml sets it to the socket proxy.
DOCKER_HOST=tcp://socket-proxy:2375
# Folder for the SQLite DB. Keep it on the wt-data volume.
WT_DATA_DIR=/data
# IPs or networks (comma-separated) of your reverse proxy (Traefik). Empty: no proxy.
WT_TRUSTED_PROXIES=
# Log level: DEBUG, INFO, WARNING or ERROR.
WT_LOG_LEVEL=INFO
# GitHub API URL. Change it only for tests.
WT_GITHUB_API_URL=https://api.github.com

# Secret: GitHub token with no scopes. It gives a higher API rate limit. Optional.
WT_GITHUB_TOKEN=
# Secret: ntfy access token, if your ntfy topic needs one. Optional.
WT_NTFY_TOKEN=
# Secret: API key of the LLM server, if it needs one. Optional.
WT_LLM_API_KEY=
