# Env vars for the dev run in wt_dev. No secrets in this file.
# Copy it to .env.dev (Git ignores it). Load it in the shell before you start WT:
#   set -a && . /workspace/.env.dev && set +a

# Docker API through the test socket proxy (task 6.1 starts it).
DOCKER_HOST=tcp://wt_test_socket_proxy:2375
# SQLite DB and other data. In the container, not on the bind mount.
WT_DATA_DIR=/home/dev/wt-data
WT_LOG_LEVEL=DEBUG
WT_GITHUB_API_URL=https://api.github.com

# Secrets: put values only in .env.dev, never in this file.
WT_GITHUB_TOKEN=
WT_NTFY_TOKEN=
WT_LLM_API_KEY=
